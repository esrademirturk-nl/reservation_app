# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/waypad

# at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars-min

# --- booking import (milestone 4) ---
# Redis for the background queue; leave empty to read imports inside the request
REDIS_URL=redis://localhost:6379
STORAGE_DIR=./storage
UPLOAD_MAX_MB=10
# with a key, bookings are read by Claude; empty = offline rule-based reader
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# signs the inbound-email webhook; empty = webhook off
INBOUND_SECRET=
